copyText(text, msg) {
if (navigator.clipboard) {
navigator.clipboard.writeText(text).then(() => this.toast(msg, 'success')).catch(() => this.toast('Copy: ' + text, 'info'));
} else {
this.toast('Code: ' + text, 'info');
}
},

shareInvite(code, url) {
if (navigator.share) {
navigator.share({ title: 'Join Earnova', text: Sign up on Earnova using my code ${code}, url }).catch(() => {});
} else {
this.copyText(url, 'Referral link copied to clipboard!');
}
},

handleSaveProfile(e) {
e.preventDefault();
const user = Store.getSession();
if (!user) return;
const chosenCurrency = document.getElementById('prof-curr').value;
const validCurrency = CONFIG.CURRENCIES[chosenCurrency] ? chosenCurrency : 'USD';
const updated = {
...user,
name: document.getElementById('prof-name').value.trim(),
country: document.getElementById('prof-country').value,
currency: validCurrency,
preferredMethod: document.getElementById('prof-method').value,
payoutAccount: document.getElementById('prof-account').value.trim(),
notifyEmail: document.getElementById('prof-notify').checked
};
Store.setSession(updated);
Store.saveUsers(Store.getUsers().map(u => u.id === updated.id ? updated : u));
this.syncSessionPreferences(updated);
this.toast('Profile and payout preferences saved.', 'success');
this.renderNavigation();
this.renderView();
},

handleResetDemo() {
if (!confirm('Reset all local transactions, completed tasks, and referrals?')) return;
Store.resetAll();
this.toast('Local prototype data reset.', 'info');
this.renderNavigation();
this.renderView();
}
};

window.addEventListener('DOMContentLoaded', () => App.init());
</script>
</body>
