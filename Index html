/**
* ============================================================================
* HELPERS & BALANCE CALCULATOR
* Strictly separates Verified Cash (`$0.00) vs Pending Demo Rewards.
* All missing or non-finite values safely initialize to 0.
* ============================================================================
*/
function esc(v) {
if (v === null || v === undefined) return '';
return String(v).replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>').replace(/"/g, '"').replace(/'/g, ''');
}

function safeNumber(val, fallback = 0) {
const n = Number(val);
return Number.isFinite(n) ? n : fallback;
}

function fmtMoney(usd, currencyCode = App.state.currency) {
const c = CONFIG.CURRENCIES[currencyCode] || CONFIG.CURRENCIES.USD;
const safeUsd = safeNumber(usd, 0);
const converted = safeUsd * safeNumber(c.rate, 1);
const safeConverted = Number.isFinite(converted) ? converted : 0;
const decimals = safeConverted >= 100 ? 0 : 2;
return ${c.symbol}${safeConverted.toLocaleString(undefined, { minimumFractionDigits: decimals, maximumFractionDigits: decimals })};
}

function getUserBalances(userId) {
const emptyBalances = {
verifiedUsd: 0,
pendingDemoUsd: 0,
availableDemoUsd: 0,
totalWithdrawRequestedUsd: 0,
earnedCount: 0
};
if (!userId) return emptyBalances;

const txs = Store.getTransactions(userId);
let verifiedUsd = 0; // Always $`0.00 in prototype unless backend verifies
let pendingDemoUsd = 0;
let totalWithdrawRequestedUsd = 0;
let earnedCount = 0;

txs.forEach(t => {
const amt = safeNumber(t && t.amountUsd, 0);
if (t && t.type === 'withdrawal') {
totalWithdrawRequestedUsd += Math.abs(amt);
} else if (t) {
if (t.status === 'verified') {
verifiedUsd += amt;
} else {
pendingDemoUsd += amt;
}
earnedCount += 1;
}
});

const availableDemoUsd = Math.max(0, pendingDemoUsd - totalWithdrawRequestedUsd);
return {
verifiedUsd: safeNumber(verifiedUsd, 0),
pendingDemoUsd: safeNumber(pendingDemoUsd, 0),
availableDemoUsd: safeNumber(availableDemoUsd, 0),
totalWithdrawRequestedUsd: safeNumber(totalWithdrawRequestedUsd, 0),
earnedCount: safeNumber(earnedCount, 0)
};
}

